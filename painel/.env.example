# Copie para painel/.env.local (e cadastre os mesmos dois valores nas variáveis
# da hospedagem). Use a chave publishable/anon, nunca a service_role.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sua-chave-publishable

# Opcional: link para baixar o app (loja). Aparece nas páginas públicas do
# trajeto compartilhado e do convite do motorista.
# VITE_DOWNLOAD_URL=https://play.google.com/store/apps/details?id=br.com.simboracar.app
