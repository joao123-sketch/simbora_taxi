# Copie para app/.env.local e preencha com os dados do projeto no Supabase
# (Project Settings > API). Use a chave publishable/anon, nunca a service_role.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sua-chave-publishable
# WhatsApp do plantão que recebe o SOS (com 55 e DDD, só números). Mais tarde
# este número passa para o banco, para a equipe trocar sem publicar o app.
EXPO_PUBLIC_SOS_WHATSAPP=5588999999999
# Site das páginas públicas (trajeto compartilhado e convite do motorista). É o
# mesmo site do painel; troque pelo domínio próprio quando existir.
# EXPO_PUBLIC_SHARE_BASE_URL=https://simbora-taxi.joaovictordesouza123-9.workers.dev
# Chave do Google Maps Platform (Maps JavaScript, Places New e Geocoding). Crie em
# console.cloud.google.com > APIs e serviços > Credenciais e restrinja aos sites do app.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=sua-chave-do-google-maps
# URL do Worker simbora-pagamentos (cobranca da mensalidade pelo Asaas)
EXPO_PUBLIC_PAGAMENTOS_URL=https://simbora-pagamentos.SEU-SUBDOMINIO.workers.dev
