{
  "expo": {
    "name": "Simbora Car",
    "slug": "simbora-car",
    "scheme": "simboracar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "primaryColor": "#D62828",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.simboracar.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "br.com.simboracar.app",
      "adaptiveIcon": {
        "backgroundColor": "#D62828",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Simbora Car usa sua localização para encontrar o carro mais perto de você."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O Simbora Car usa a câmera só para ler o QR do seu motorista."
        }
      ],
      "expo-status-bar"
    ],
    "description": "Corridas de carro e moto na sua cidade, de um jeito simples."
  }
}
